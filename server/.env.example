# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/actora

# Secret used to sign session tokens. Use a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the API listens on
PORT=5233

# Comma-separated list of web origins allowed to call the API
CLIENT_ORIGIN=http://localhost:3000

# Number of reverse proxies in front of the API (e.g. 1 on Heroku/Render). Leave 0 locally.
TRUST_PROXY=0
